JWT_SECRET=local-demo-insurance-jwt-secret-2026-abcdef1234567890

# Blockchain RPC Configuration
BLOCKCHAIN_MODE=rpc
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=31337

# Deployed InsuranceClaimHub Contract Address
INSURANCE_CONTRACT_ADDRESS=0x2279B7A0a67DB372996a5FaB50D91eAA73d2eBe6
NEXT_PUBLIC_INSURANCE_CONTRACT_ADDRESS=0x2279B7A0a67DB372996a5FaB50D91eAA73d2eBe6

# Server Operator Signer Key (Account #0 - Deployer & Admin)
# WARNING: NEVER prefix with NEXT_PUBLIC_ to prevent browser leakage
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Blockchain Demo Conversion Rate: USD to ETH (1000 USD = 1 ETH = 1e18 wei)
# WARNING: This is for LOCAL DEMO conversion only. Do NOT use as a live production oracle.
DEMO_USD_PER_ETH=1000
NEXT_PUBLIC_DEMO_USD_PER_ETH=1000
BLOCKCHAIN_PAYOUT_CONVERSION_MODE=demo-fixed-rate